{
 "uid": "ett-timeline",
 "title": "Timeline",
 "tags": [
  "event-timeline-tiled"
 ],
 "schemaVersion": 41,
 "editable": false,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-12h",
  "to": "now"
 },
 "timepicker": {
  "refresh_intervals": [
   "10s",
   "30s",
   "1m",
   "5m"
  ]
 },
 "templating": {
  "list": [
   {
    "name": "run",
    "type": "textbox",
    "hide": 2,
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   },
   {
    "name": "stream",
    "type": "textbox",
    "hide": 2,
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   }
  ]
 },
 "panels": [
  {
   "type": "text",
   "title": "",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "transparent": true,
   "options": {
    "mode": "markdown",
    "content": "**Recorded runs from Tiled.** Click a run to select it. Green success \u00b7 red failed \u00b7 orange aborted \u00b7 blue open \u00b7 yellow possibly stalled \u00b7 light blue activity unknown \u00b7 grey stale. [Health](/d/ett-health/timeline-health)"
   }
  },
  {
   "type": "table",
   "title": "Queue",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 9,
    "h": 4
   },
   "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "timeline-adapter"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "yesoreyeram-infinity-datasource",
      "uid": "timeline-adapter"
     },
     "type": "json",
     "source": "url",
     "parser": "backend",
     "format": "table",
     "url": "http://adapter:8000/queues",
     "url_options": {
      "method": "GET",
      "data": ""
     },
     "root_selector": "",
     "columns": [
      {
       "selector": "instrument",
       "text": "instrument",
       "type": "string"
      },
      {
       "selector": "state",
       "text": "state",
       "type": "string"
      },
      {
       "selector": "running_plan",
       "text": "running_plan",
       "type": "string"
      },
      {
       "selector": "running_since",
       "text": "running_since",
       "type": "timestamp_epoch_s"
      },
      {
       "selector": "items_in_queue",
       "text": "items_in_queue",
       "type": "number"
      }
     ]
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "fieldConfig": {
    "defaults": {
     "noValue": "no RE Manager configured"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "items_in_queue"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 115
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "instrument"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 90
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "running_since"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 150
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "state"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 120
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "items_in_queue"
      },
      "properties": [
       {
        "id": "noValue",
        "value": "\u2013"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "running_plan"
      },
      "properties": [
       {
        "id": "noValue",
        "value": "\u2013"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "running_since"
      },
      "properties": [
       {
        "id": "noValue",
        "value": "\u2013"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "state"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "idle": {
            "color": "green",
            "index": 0
           },
           "executing_queue": {
            "color": "blue",
            "index": 1
           },
           "paused": {
            "color": "orange",
            "index": 2
           },
           "unreachable": {
            "color": "red",
            "index": 3
           },
           "error": {
            "color": "red",
            "index": 4
           }
          }
         }
        ]
       }
      ]
     }
    ]
   }
  },
