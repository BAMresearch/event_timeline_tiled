      },
      {
       "selector": "stale",
       "text": "stale",
       "type": "boolean"
      }
     ]
    }
   ],
   "transformations": [
    {
     "id": "partitionByValues",
     "options": {
      "fields": [
       "lane"
      ],
      "keepFields": false,
      "naming": {
