{
 "uid": "ett-timeline",
 "title": "Timeline",
 "tags": [
  "event-timeline-tiled"
 ],
 "schemaVersion": 41,
 "editable": false,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-12h",
  "to": "now"
 },
 "timepicker": {
  "refresh_intervals": [
   "10s",
   "30s",
   "1m",
   "5m"
  ]
 },
 "templating": {
  "list": [
   {
    "name": "run",
    "type": "textbox",
    "hide": 2,
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   }
  ]
 },
 "panels": [
  {
   "type": "text",
   "title": "",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 18,
    "h": 2
   },
   "transparent": true,
   "options": {
    "mode": "markdown",
    "content": "**Recorded runs from Tiled.** Click a run on the timeline or in *Runs in range* to select it. Colours: green success, red failed, orange aborted, blue open, yellow possibly stalled, grey stale. [Health](/d/ett-health/timeline-health)"
   }
  },
  {
   "type": "stat",
   "title": "Data age",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 2
   },
   "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "timeline-adapter"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "yesoreyeram-infinity-datasource",
      "uid": "timeline-adapter"
     },
     "type": "json",
     "source": "url",
     "parser": "backend",
     "format": "table",
     "url": "http://adapter:8000/health",
     "url_options": {
      "method": "GET",
      "data": ""
     },
     "root_selector": "",
     "columns": [
      {
       "selector": "data_age_s",
       "text": "data_age_s",
       "type": "number"
      }
     ]
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "max"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "noValue": "no fetch yet",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 120
       },
       {
        "color": "red",
        "value": 600
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "table",
   "title": "Runs in range",
   "gridPos": {
    "x": 0,
    "y": 2,
    "w": 7,
    "h": 7
   },
   "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "timeline-adapter"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "yesoreyeram-infinity-datasource",
      "uid": "timeline-adapter"
     },
     "type": "json",
     "source": "url",
     "parser": "backend",
     "format": "table",
     "url": "http://adapter:8000/clips?from=${__timeFrom:date:seconds}&to=${__timeTo:date:seconds}",
     "url_options": {
      "method": "GET",
      "data": ""
     },
     "root_selector": "clips",
     "columns": [
      {
       "selector": "label",
       "text": "label",
       "type": "string"
      },
      {
       "selector": "start",
       "text": "start",
       "type": "timestamp_epoch_s"
      },
      {
       "selector": "status",
       "text": "status",
       "type": "string"
      },
      {
       "selector": "uid",
       "text": "uid",
       "type": "string"
      }
     ]
    }
   ],
   "options": {
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "start",
      "desc": true
     }
    ]
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "uid"
      },
      "properties": [
       {
        "id": "custom.hidden",
        "value": true
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "label"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Select run",
          "url": "/d/ett-timeline/timeline?var-run=${__data.fields[\"uid\"]}&${__url_time_range}"
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "status"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "success": {
            "color": "green",
            "index": 0
           },
           "failed": {
            "color": "red",
            "index": 1
           },
           "aborted": {
            "color": "orange",
            "index": 2
           },
           "unknown": {
            "color": "purple",
            "index": 3
           },
           "open": {
            "color": "blue",
            "index": 4
           },
           "possibly stalled": {
            "color": "yellow",
            "index": 5
           },
           "stale": {
            "color": "gray",
            "index": 6
           }
          }
         }
        ]
       }
      ]
     }
    ]
   }
  },
  {
   "type": "table",
   "title": "Failed and aborted",
   "gridPos": {
    "x": 7,
    "y": 2,
    "w": 5,
    "h": 7
   },
   "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "timeline-adapter"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "yesoreyeram-infinity-datasource",
      "uid": "timeline-adapter"
     },
     "type": "json",
     "source": "url",
     "parser": "backend",
     "format": "table",
     "url": "http://adapter:8000/clips?from=${__timeFrom:date:seconds}&to=${__timeTo:date:seconds}&status=failed,aborted",
     "url_options": {
      "method": "GET",
      "data": ""
     },
     "root_selector": "clips",
     "columns": [
      {
       "selector": "label",
       "text": "label",
       "type": "string"
      },
      {
       "selector": "reason",
       "text": "reason",
       "type": "string"
      },
      {
       "selector": "start",
       "text": "start",
       "type": "timestamp_epoch_s"
      },
      {
       "selector": "uid",
       "text": "uid",
       "type": "string"
      }
     ]
    }
   ],
   "options": {
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "start",
      "desc": true
     }
    ]
   },
   "fieldConfig": {
    "defaults": {
     "noValue": "none in range"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "uid"
      },
      "properties": [
       {
        "id": "custom.hidden",
        "value": true
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "label"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Select run",
          "url": "/d/ett-timeline/timeline?var-run=${__data.fields[\"uid\"]}&${__url_time_range}"
         }
        ]
       }
      ]
     }
    ]
   }
  },
  {
   "type": "table",
