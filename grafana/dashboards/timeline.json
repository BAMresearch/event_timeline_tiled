     },
     "type": "json",
     "source": "url",
     "parser": "backend",
     "format": "timeseries",
     "url": "http://adapter:8000/runs/${run:percentencode}/data?kind=timeseries&max_points=2000",
     "url_options": {
      "method": "GET",
