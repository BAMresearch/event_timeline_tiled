  {
   "type": "table",
   "title": "Run data (default view)",
   "gridPos": {
    "x": 12,
    "y": 2,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "timeline-adapter"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
