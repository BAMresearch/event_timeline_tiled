     "color": {
      "mode": "fixed",
      "fixedColor": "gray"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "success": {
         "color": "green",
         "index": 0
        },
        "failed": {
         "color": "red",
         "index": 1
