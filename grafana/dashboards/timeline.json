       "type": "string"
      },
      {
       "selector": "value",
       "text": "value",
       "type": "string"
      }
     ]
    }
   ],
   "options": {
    "showHeader": false
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "type": "table",
   "title": "Streams",
   "gridPos": {
    "x": 7,
    "y": 9,
    "w": 5,
    "h": 7
   },
   "datasource": {
    "type": "yesoreyeram-infinity-datasource",
