# Same-origin reverse proxy: Grafana, plus /run-images/ from the adapter for
# signed-in Grafana users only (plan §6; tested in the spike, gate 1.3).
events {}
http {
  server_tokens off;
  # Docker's embedded DNS. Other runtimes (Podman) use a different address:
  # untested, so the stack supports Docker only for now (review 04).
  resolver 127.0.0.11 valid=10s;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  server {
    listen 8080;

    location / {
      set $grafana http://grafana:3000;
      proxy_pass $grafana;
      proxy_set_header Host $http_host;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
    }

    # Images: GET only, forwarded without browser credentials, only after
    # Grafana confirms the session. The adapter sets Cache-Control.
    location /run-images/ {
      limit_except GET { deny all; }
      auth_request /_grafana_session;
      set $adapter http://adapter:8000;
      proxy_pass $adapter;
      proxy_set_header Authorization "";
      proxy_set_header Cookie "";
    }

    location = /_grafana_session {
      internal;
      set $grafana_user http://grafana:3000/api/user;
      proxy_pass $grafana_user;
      proxy_pass_request_body off;
      proxy_set_header Content-Length "";
      proxy_set_header Cookie $http_cookie;
      proxy_set_header Authorization "";
    }
  }
}
