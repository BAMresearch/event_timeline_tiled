# Same-origin reverse proxy: Grafana, plus /run-images/ from the adapter for
# signed-in Grafana users only (plan §6; tested in the spike, gate 1.3).
#
# A template: the nginx image's entrypoint fills in NGINX_LOCAL_RESOLVERS from
# the container's /etc/resolv.conf (NGINX_ENTRYPOINT_LOCAL_RESOLVERS in
# compose.yaml) and writes the result to /etc/nginx/conf.d/default.conf, inside
# the image's http block. That is Docker's embedded DNS (127.0.0.11) under
# Docker and aardvark-dns (the network's gateway) under Podman with netavark.
# Names are resolved at request time, so a restarted Grafana or adapter with a
# new address is found again without restarting the proxy.
server_tokens off;
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 8080;

  location / {
    set $grafana http://grafana:3000;
    proxy_pass $grafana;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }

  # Images: GET only, forwarded without browser credentials, only after
  # Grafana confirms the session. The adapter sets Cache-Control.
  location /run-images/ {
    limit_except GET { deny all; }
    auth_request /_grafana_session;
    set $adapter http://adapter:8000;
    proxy_pass $adapter;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
  }

  location = /_grafana_session {
    internal;
    set $grafana_user http://grafana:3000/api/user;
    proxy_pass $grafana_user;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Cookie $http_cookie;
    proxy_set_header Authorization "";
  }
}
