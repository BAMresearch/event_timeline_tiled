# Copy to deploy/.env and replace every "change-me". deploy/.env is not committed.
# Generate secrets with e.g.:  python3 -c "import secrets; print(secrets.token_hex(32))"

# Grafana admin (the dashboards are read-only for Viewer accounts).
GF_ADMIN_PASSWORD=change-me
# Address users open; must match the proxy (ETT_HTTP_PORT).
ETT_PUBLIC_URL=http://localhost:8080/
ETT_HTTP_PORT=8080

# Tiled the adapter reads. Default: the demo stack's own Tiled.
# For the lab server: its URL here, and ETT_SECRETS=/path/to/dir holding adapter.key
# (directory 750 and file 640, group 10001: see docs/technical/tiled-access.md).
ETT_TILED_URL=http://tiled:8000
ETT_CATALOG_ROOTS=
# RE Managers for the queue-status panel: instrument=zmq:tcp://host:60615 or
# instrument=http:http://host:60610 (HTTP key file: see docs/technical/queues.md).
# Default: the demo stack's own RE Manager.
ETT_QUEUES=MOUSE=zmq:tcp://re-manager:60615
# Presets (docs/technical/presets.md): a directory of YAML files (default
# deploy/presets) and the preset the dashboard starts with.
# ETT_PRESETS=/path/to/presets
# ETT_DEFAULT_PRESET=instruments
# ETT_SECRETS=/path/to/dir

# Demo profile only. These three: at least 16 characters of A-Z a-z 0-9 - _
# (the hex output above qualifies); the Tiled container refuses anything else.
POSTGRES_PASSWORD=change-me
TILED_ADMIN_PASSWORD=change-me
TILED_SECRET_KEY=change-me
ETT_DEMO_TILED_PORT=8001
